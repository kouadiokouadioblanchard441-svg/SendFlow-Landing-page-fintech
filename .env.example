# API / Plesk Node application
NODE_ENV=production
PORT=3000
NEON_DATABASE_URL=postgresql://...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SendFlow <newsletter@your-verified-domain.com>
PUBLIC_SITE_URL=https://www.example.com
BASE_PATH=/
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
LOG_LEVEL=info

# Frontend build-time variables
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_CLERK_PROXY_URL=/api/__clerk
VITE_PUBLIC_SITE_URL=https://www.example.com

# One-time database/admin provisioning variables
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_PANEL_TOKEN=replace-with-a-long-random-token
ADMIN_PANEL_EMAIL=admin@example.com

# Build-time values required by artifacts/sendflow/vite.config.ts
# PORT=3000 and BASE_PATH=/ are also needed when running the web build.