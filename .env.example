# API / Plesk Node application
NODE_ENV=production
PORT=
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@example.com
APP_URL=https://sendflow.africa
PUBLIC_SITE_URL=https://sendflow.africa
BASE_PATH=/
LOG_LEVEL=info

# One-time database/admin provisioning variables
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
ADMIN_PANEL_TOKEN=replace-with-a-long-random-token
ADMIN_PANEL_EMAIL=admin@example.com

# Build-time values required by artifacts/sendflow/vite.config.ts
# BASE_PATH=/

# Optional production overrides (normally leave unset)
# CORS_ORIGINS=https://sendflow.africa
# WEB_DIST_DIR=/path/to/dist/public

# Required on Plesk for durable media uploads and serving.
# Keep this absolute, writable by the Node process, and outside dist/public.
PLESK_MEDIA_DIR=/var/lib/sendflow/media

# Managed development object-storage configuration; not used when PLESK_MEDIA_DIR is set.
# PUBLIC_OBJECT_SEARCH_PATHS=/bucket/public

# Optional Google reCAPTCHA v3 for the public newsletter form.
# Register sendflow.africa (and www.sendflow.africa if used) in Google reCAPTCHA.
# Configure both keys together in Plesk Node.js environment settings.
# RECAPTCHA_SITE_KEY=your_public_site_key
# RECAPTCHA_SECRET_KEY=your_private_secret_key

# Development only (not required on Plesk)
# API_PORT=8080
# WEB_PORT=3000
# API_ORIGIN=http://127.0.0.1:8080

# One-time editorial provisioning only; do not enable during normal startup
# REFRESH_LEGAL_CONTENT=false

# Required by the application for shared authentication rate limits.
# Configure a unique, long random value in the Node.js environment; never commit it.
# SESSION_SECRET=replace-with-a-long-random-secret

# Optional Telegram security monitoring. Leave disabled until the privacy notice,
# group, administrator IDs, and Plesk proxy IP configuration are verified.
# Configure actual values only in Plesk Node.js environment settings.
# TELEGRAM_AUDIT_ENABLED=false
# TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# TELEGRAM_CHAT_ID=replace-with-private-group-id
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-letters-numbers-underscores-value
# TELEGRAM_ADMIN_USER_IDS=123456789
# TELEGRAM_AUTO_CONFIGURE_WEBHOOK=false
# TRUSTED_PROXY_IPS=replace-with-verified-proxy-addresses

# DATABASE_URL is not read by the current SendFlow code.
# Never commit a real .env file. Plesk must inject runtime variables into Node.
# A root .env file is not automatically loaded by the Node startup command.
