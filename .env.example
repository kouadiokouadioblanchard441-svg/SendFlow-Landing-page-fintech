# API / Plesk Node application
NODE_ENV=production
PORT=3000
NEON_DATABASE_URL=postgresql://...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SendFlow <newsletter@your-verified-domain.com>
APP_URL=https://sendflow.africa
PUBLIC_SITE_URL=https://sendflow.africa
BASE_PATH=/
LOG_LEVEL=info

# VITE_PUBLIC_SITE_URL is normally derived from APP_URL or PUBLIC_URL by scripts/plesk-deploy.sh.
# The Plesk build/runtime also accepts an existing VITE_PUBLIC_SITE_URL as a fallback.

# One-time database/admin provisioning variables
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_PANEL_TOKEN=replace-with-a-long-random-token
ADMIN_PANEL_EMAIL=admin@example.com

# Build-time values required by artifacts/sendflow/vite.config.ts
# BASE_PATH=/ selects the production root. Vite defaults PORT to 3000 at build time.

# Optional production overrides (normally leave unset)
# CORS_ORIGINS=https://another-allowed-origin.example.com
# WEB_DIST_DIR=/absolute/path/to/project/dist/public

# Required on Plesk for durable media uploads and serving.
# Keep this absolute, writable by the Node process, and outside dist/public.
PLESK_MEDIA_DIR=/absolute/path/outside/dist/public/sendflow-media

# Managed development object-storage configuration; not used when PLESK_MEDIA_DIR is set.
# PUBLIC_OBJECT_SEARCH_PATHS=/bucket/public

# Development only (not required on Plesk)
# API_PORT=8080
# WEB_PORT=26095
# API_ORIGIN=http://127.0.0.1:8080

# One-time editorial provisioning only; do not enable during normal startup
# REFRESH_LEGAL_CONTENT=true

# PUBLIC_SITE_URL is used by the server; APP_URL or PUBLIC_URL are accepted aliases.
# SESSION_SECRET and DATABASE_URL are not read by the current SendFlow code.
# Never commit a real .env file. Plesk must inject runtime variables into Node.
# A root .env file is not automatically loaded by the Node startup command.