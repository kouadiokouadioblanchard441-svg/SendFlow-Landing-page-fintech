<IfModule mod_rewrite.c>
RewriteEngine On
# Retire historical admin links that placed access credentials in the path.
RewriteRule ^panel/[^/]+/[^/]+/?$ /panel [R=302,L,NC]
RewriteRule ^favicon\.ico$ favicon.svg [L]
# Keep API requests for the Passenger application; never rewrite them to the SPA.
RewriteRule ^api(/|$) - [L,NC]
# Serve generated SEO route files without Apache's directory-slash redirect.
RewriteRule ^en/?$ en/index.html [L]
RewriteRule ^fonctionnalites/?$ fonctionnalites/index.html [L]
RewriteRule ^en/features/?$ en/features/index.html [L]
RewriteRule ^api-developpeur/?$ api-developpeur/index.html [L]
RewriteRule ^en/developer-api/?$ en/developer-api/index.html [L]
RewriteRule ^securite/?$ securite/index.html [L]
RewriteRule ^en/security/?$ en/security/index.html [L]
RewriteRule ^download/?$ download/index.html [L]
RewriteRule ^en/download/?$ en/download/index.html [L]
RewriteRule ^a-propos/?$ a-propos/index.html [L]
RewriteRule ^en/about/?$ en/about/index.html [L]
RewriteRule ^conditions-utilisation/?$ conditions-utilisation/index.html [L]
RewriteRule ^en/terms/?$ en/terms/index.html [L]
RewriteRule ^confidentialite/?$ confidentialite/index.html [L]
RewriteRule ^en/privacy/?$ en/privacy/index.html [L]
RewriteRule ^mentions-legales/?$ mentions-legales/index.html [L]
RewriteRule ^en/legal-notice/?$ en/legal-notice/index.html [L]
RewriteRule ^france-senegal/?$ france-senegal/index.html [L]
RewriteRule ^en/france-senegal/?$ en/france-senegal/index.html [L]
RewriteRule ^tarifs/?$ tarifs/index.html [L]
RewriteRule ^en/pricing/?$ en/pricing/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_setenvif.c>
SetEnvIf Request_URI "^/panel/[^/]+/[^/]+/?$" sendflow_legacy_panel
SetEnvIf Request_URI "^/api(/|$)" sendflow_api
</IfModule>
<IfModule mod_headers.c>
Header onsuccess unset X-Powered-By
Header always unset X-Powered-By
Header always set X-Content-Type-Options "nosniff"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self' https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; object-src 'none'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; font-src 'self' data: https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; manifest-src 'self'; worker-src 'self' blob:" env=!sendflow_api
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-Robots-Tag "noindex, nofollow" env=sendflow_legacy_panel
Header always set Referrer-Policy "no-referrer" env=sendflow_legacy_panel
Header always set Cache-Control "no-store" env=sendflow_legacy_panel
</IfModule>
